{
  "name": "Elemental Creatures",
  "menuBackgroundImage": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/images/menu_background.webp",
  "defaultRessources": {
    "backgrounds": [
      "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/images/banner.webp"
    ]
  },
  "deckBuilding": {
    "mainFilters": ["elements", "species", "power", "level"],
    "formats": [
      { "title": "Constructed", "gameplay": "Constructed" }
    ]
  },
  "deckRulesets": {
    "Constructed": {
      "general": { "min": 40, "maxPerCard": 3 }
    }
  },
  "gameplay": {
    "Constructed": {
      "draggableTokens": [
        {"id": "Disarmed", "name": "Disarmed", "image": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/images/disabled.png"}
      ],
      "mulligan": { 
        "triggeredByButton": false,
        "startingHandSize": 7,
        "mulliganCount": {
          "min": 0,
          "max": 3
        },
        "mulliganCycle": {
          "info": "You can select as many cards in your hand as you like to put back in your deck to redraw that same amount of cards. You can do this up to 3 times.",
          "steps": [
            "toBottom",
            "draw",
            "shuffle"
          ],
          "selectionRange": {
            "min": 1,
            "max": 7
          }
        }
      },
      "newTurn": { 
        "drawOnStart": false,
        "sharedTurn": false,
        "drawPerTurn": 1
      },
      "countersStartingValues": [0],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [{ "section": "Frontline" }, {"section":"Sideline"}]
        },
        "sectionsDict": {
          "Frontline": {
            "isHidden": "no",
            "height": "50",
            "alignment": "CENTER",
            "cardActionShortcut": {
              "action": "MOVE",
              "actionData": {
                "destination": "Sideline"
              }
            }
          },
          "Sideline": {
            "isHidden": "no",
            "height": "50",
            "alignment": "CENTER",
            "cardActionShortcut": {
              "action": "MOVE",
              "actionData": {
                "destination": "Discard"
              }
            }
          }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/cards.json",
    "cardBack": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/images/back.webp"
  }
}