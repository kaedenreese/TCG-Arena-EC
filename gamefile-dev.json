{
  "name": "Elemental Creatures Dev Version",
  "menuBackgroundImage": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/images/main_image.webp",
  "defaultRessources": {
    "decksUrl": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/decks.json"
  },
  "scriptsUrls": [
    "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/js/updatePower.js"
  ],
  "deckBuilding": {
    "mainFilters": ["Elements", "Species", "Level"],
    "formats": [
      { "title": "Constructed", "gameplay": "Constructed" }
    ]
  },
  "deckRulesets": {
    "Constructed": {
      "general": { "min": 40, "maxPerCard": 3 }
    }
  },
  "gameplay": {
    "Constructed": {
      "draggableTokens": [
        {"id": "Disarmed", "name": "Disarmed", "image": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/images/disabled.png"}
      ],
      "mulligan": { 
        "triggeredByButton": false,
        "startingHandSize": 7,
        "mulliganCount": {
          "min": 0,
          "max": 3
        },
        "mulliganCycle": {
          "info": "You can select as many cards in your hand as you like to put back in your deck to redraw that same amount of cards. You can do this up to 3 times.",
          "steps": [
            "toBottom",
            "draw",
            "shuffle"
          ],
          "selectionRange": {
            "min": 1,
            "max": 7
          }
        }
      },
      "newTurn": { 
        "drawOnStart": false,
        "sharedTurn": false,
        "drawPerTurn": 0
      },
      "defaultNotes": "Round Power: 0",
      "countersStartingValues": [0],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "section": "Power",
              "style": {
                "position": "absolute",
                "height": "100px",
                "width": "100px"
              }
            },
            { "section": "Frontline" },
            { "section": "Sideline"}
          ]
        },
        "autoPlayFromHand": {
          "Creature": "Frontline"
        },
        "autoPlayFromStack": {
          "Creature": "Frontline"
        },
        "sectionsDict": {
          "Power": {
            "type": "custom",
            "defaultValue": { "power": 0 },
            "blueprint": {
                "type": "div",
                "children": "{{ game.data.Power.power }} Power"
            },
            "isHidden": "no",
            "height": 10,
            "alignment": "CENTER"
          },
          "Frontline": {
            "isHidden": "no",
            "height": 15,
            "alignment": "CENTER",
            "keepTappedNewTurn": true,
            "cardActionShortcut": {
              "action": "MOVE",
              "actionData": {
                "destination": "Sideline"
              }
            },
            "events": {
                "onUpdate": "await updatePower()"
            }
          },
          "Sideline": {
            "isHidden": "no",
            "height": 15,
            "alignment": "CENTER",
            "keepTappedNewTurn": true,
            "cardActionShortcut": {
              "action": "MOVE",
              "actionData": {
                "destination": "Hand"
              }
            }
          }
        }
      }
    }
  },
  "cards": {
    "dataUrl": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/cards-dev.json",
    "cardBack": "https://raw.githubusercontent.com/kaedenreese/TCG-Arena-EC/refs/heads/main/images/back.webp"
  }
}